{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "OneRep",
  "description": "Documentation for OneRep — training and nutrition in one log.",
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#171a18",
    "light": "#e8e6df",
    "dark": "#171a18"
  },
  "fonts": {
    "heading": {
      "family": "Instrument Sans"
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "appearance": {
    "default": "system"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://onerep.life"
  },
  "navbar": {
    "links": [
      {
        "label": "Open the app",
        "href": "https://app.onerep.life"
      },
      {
        "label": "Support",
        "href": "mailto:hi@onerep.life"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/an2tha/onerep"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "account-setup"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/dashboard",
              "features/nutrition",
              "features/training",
              "features/progress",
              "features/coach"
            ]
          },
          {
            "group": "Self-Hosting",
            "pages": [
              "selfhost/overview",
              "selfhost/install",
              "selfhost/food-database",
              "selfhost/mobile-apps",
              "selfhost/integrations"
            ]
          },
          {
            "group": "Settings & Privacy",
            "pages": [
              "settings/account",
              "settings/targets",
              "settings/data-export",
              "settings/privacy"
            ]
          }
        ]
      },
      {
        "tab": "API & MCP",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/overview",
              "api/authentication"
            ]
          },
          {
            "group": "REST API",
            "pages": [
              "api/rest/read-endpoints",
              "api/rest/write-endpoints",
              "api/rest/errors"
            ]
          },
          {
            "group": "MCP",
            "pages": [
              "api/mcp/overview",
              "api/mcp/tools",
              "api/mcp/oauth"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "OneRep",
            "href": "https://onerep.life"
          },
          {
            "label": "Open the app",
            "href": "https://app.onerep.life"
          }
        ]
      },
      {
        "header": "Docs",
        "items": [
          {
            "label": "Quickstart",
            "href": "/quickstart"
          },
          {
            "label": "API & MCP",
            "href": "/api/overview"
          },
          {
            "label": "Self-hosting",
            "href": "/selfhost/overview"
          }
        ]
      },
      {
        "header": "Source",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/an2tha/onerep"
          }
        ]
      }
    ]
  }
}
